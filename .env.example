# docker compose 变量模板。
# 首次运行 scripts/up-linux.sh 时自动复制为 .env（并把 JWT_SECRET 替换为随机值）。
# .env 已在 .gitignore，不会入库；也可不用 .env，直接用 shell 环境变量覆盖（优先级更高）。

# MySQL root 口令：compose 的 mysql 服务与 app 共用同一口令，务必改成强口令。
MYSQL_PWD=change_me_to_a_strong_password

# JWT 签名密钥：up-linux.sh 引导 .env 时会用 openssl rand -hex 32 自动覆盖本行；
# 若手动创建 .env，请务必改为强随机值，例如：openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_string

# 静态资源对外基址：app 下发的 play_url / cover_url 前缀（gin r.Static("/static","/data")）。
# 本机访问用默认值即可；部署到服务器/虚拟机时改为对外的 IP 或域名，例如：
# PUBLIC_BASE_URL=http://192.168.1.7:8000/static
