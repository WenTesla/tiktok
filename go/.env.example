# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=zhang134679
MYSQL_DB=tiktok
MYSQL_CHARSET=utf8mb4
MYSQL_LOC=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_HOURS=168

# 腾讯云 COS（OSS）—— 已弃用：Phase 7 起视频/封面改走本地文件系统存储，
# 不配置 COS_* 也不影响任何接口。以下仅保留作兼容，可忽略。
OSS_SECRET_ID=your_secret_id
OSS_SECRET_KEY=your_secret_key
OSS_COS_URL=https://your-bucket.cos.ap-beijing.myqcloud.com
OSS_COS_URL_AND=https://your-bucket.cos.ap-beijing.myqcloud.com/
OSS_REPLACE_SUFFIX=.jpg

# 本地存储（视频/封面落盘 + 静态路由对外提供）
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/data
PUBLIC_BASE_URL=http://localhost:8000/static

# Server
SERVER_PORT=8000
